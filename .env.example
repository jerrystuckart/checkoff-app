# Copy to .env and fill in locally. Never commit real values — .env itself
# is gitignored; only this template (with placeholders, no real secrets)
# is tracked.

# Phase 0C agent-service read/query layer (agent-service/db.ts).
# Postgres connection string authenticated as the `agent_service` role
# created in Phase 0A — NOT the Supabase service_role key, and not the
# anon/public key used elsewhere in this app. Recommended: Supabase's
# Supavisor session-mode pooler host (see docs/agent-platform/ Phase 0C
# notes for why). Format:
#   postgresql://agent_service:<password>@<pooler-host>:5432/postgres
AGENT_SERVICE_DATABASE_URL=

# Phase 0D safety gate — NOT a secret, leave unset/0 by default. Setting
# this to 1 is what allows agent-service/mutations.test.ts's integration
# tests to run at all; without it they skip even when
# AGENT_SERVICE_DATABASE_URL points at a real database, so routine
# `npm run agent:test` can never write to production merely by being run.
# Set to 1 only when you deliberately want to run the live mutation tests
# (`npm run agent:test:mutations`).
AGENT_SERVICE_ALLOW_MUTATION_TESTS=

# Phase 0F Open Brain write-back (agent-service/openBrainClient.ts).
# IMPORTANT — as of Phase 0F, setting these does NOT make the integration
# work: agent-service is a standalone Node process with no MCP access, and
# there is no confirmed, implemented transport connecting it to Open Brain
# yet (the only Open Brain access that exists today is via a Claude Code
# session's own MCP tools, which a background Node process cannot call).
# getDefaultOpenBrainClient() reads these only to produce an honest error
# message and never sends a real request. Do not expect real writes to
# work until a real transport is implemented and confirmed — see
# openBrainClient.ts's module doc.
OPEN_BRAIN_MCP_URL=
OPEN_BRAIN_MCP_KEY=

# Not a secret. Same pattern as AGENT_SERVICE_ALLOW_MUTATION_TESTS — leave
# unset/0. Gates any live-Open-Brain-connectivity test in
# agent-service/openBrainDecisions.test.ts (there are none as of Phase 0F,
# since no real transport exists to test against yet; reserved for when
# one does).
AGENT_SERVICE_ALLOW_OPEN_BRAIN_TESTS=
